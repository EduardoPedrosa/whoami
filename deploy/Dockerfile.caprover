FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && rm -rf /var/lib/apt/lists/*
COPY package.json yarn.lock tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/package.json
COPY frontend/package.json frontend/package.json
COPY backend/package.json backend/package.json
RUN yarn install --frozen-lockfile --non-interactive
COPY packages/shared packages/shared
COPY backend backend
RUN yarn build:shared && yarn workspace @whoami/backend build && yarn vitest run
RUN yarn install --production --frozen-lockfile --non-interactive --ignore-scripts

FROM node:22-bookworm-slim
ENV NODE_ENV=production PORT=3005 STORAGE_MODE=memory
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/shared ./packages/shared
COPY --from=build /app/backend/package.json ./backend/package.json
COPY --from=build /app/backend/dist ./backend/dist
USER node
EXPOSE 3005
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD node -e "fetch('http://127.0.0.1:'+process.env.PORT+'/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "backend/dist/main.js"]
