{
  "name": "@whoami/backend",
  "version": "2.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc-watch --onSuccess \"node --env-file-if-exists=.env dist/main.js\"",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@whoami/shared": "2.0.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/platform-socket.io": "^12.2.0",
    "@nestjs/websockets": "^12.2.0",
    "better-sqlite3": "^13.0.3",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "socket.io-client": "^4.8.4",
    "tsc-watch": "^7.2.0"
  }
}
